#!/bin/zsh
# Launches Athar from the project folder this bundle sits in. The app's code lives there, not in this bundle.
PROJECT="${0:A:h:h:h:h}"
cd "$PROJECT" || exit 1
if [[ -x "$PROJECT/.venv/bin/python" ]]; then
  exec "$PROJECT/.venv/bin/python" -m athar.app
fi
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
exec uv run athar
