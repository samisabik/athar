{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athar",
  "identifier": "io.github.samisabik.athar",
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../assets/Athar.icns",
      "icons/icon.png"
    ],
    "category": "Music",
    "resources": {
      "ui/": "ui/",
      "../build/model/text.onnx": "model/text.onnx",
      "../build/model/tokenizer.json": "model/tokenizer.json",
      "../build/model-audio-pc/audio.onnx": "model/audio.onnx"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}